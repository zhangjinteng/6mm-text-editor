{
  "name": "tinymce-vue-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/editor.mjs --prepare && vite --host 127.0.0.1",
    "build": "node scripts/editor.mjs --prepare && vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm test:server && playwright test",
    "test:server": "node --experimental-strip-types --test server/*.test.ts",
    "editor:build": "node scripts/editor.mjs --build",
    "editor:sync": "node scripts/editor.mjs --sync",
    "gifts:update": "node scripts/bilibili-gifts.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.63.0",
    "@tinymce/tinymce-vue": "6.3.0",
    "animate.css": "4.1.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "tinymce": "^8.10.1",
    "tinymce-i18n": "26.10.26",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vue-tsc": "^3.1.0"
  }
}
